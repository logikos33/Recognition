[Unit]
# Daemon completo do edge-sync-agent (PR-C run_daemon(): evidence/discovery API +
# config_poller/command_poller/uploader/heartbeat). ver AGENT.md.
#
# systemd --user (NÃO system): docs/edge/REGRAS_PLATAFORMA_JETSON.md §3.4 —
# "Sem sudo no box (execução autônoma)... systemd de sistema" bloqueado; o padrão
# JÁ PROVADO no soak (task-113, GO em 4.8h) é systemctl --user + cgroup v2
# delegado + Linger=yes (já ativo em pandora) para sobreviver a reboot sem login.
# Instalar em ~/.config/systemd/user/ — ver deploy/install.sh (sem sudo).
#
# OTA (ADR-0057 item 10, bare-metal): WorkingDirectory/ExecStart apontam pro
# symlink `current` (não mais um checkout fixo) — app/ota/updater.py troca
# esse symlink atomicamente e reinicia esta unit quando publica um release
# novo. `current` resolve pra releases/<ref>/services/edge-sync-agent, cada
# release com o próprio venv (git worktree + venv por ref, sem Docker).
Description=Recognition edge-sync-agent (identidade + evidence/discovery API + sync loops)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/recognition/current
EnvironmentFile=%h/.config/recognition/edge-sync-agent.env
ExecStart=%h/recognition/current/.venv/bin/python -m app.main
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Budget da tabela em deployments/edge/README.md (§Cap por serviço) — auxiliar,
# sacrificável antes do pipeline DeepStream. OOMScoreAdjust positivo não exige
# privilégio (REGRAS §3.4).
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=128M
OOMScoreAdjust=100

[Install]
WantedBy=default.target
