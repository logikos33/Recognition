# Config do daemon do edge-sync-agent (PR-C run_daemon). Copiar para
# /home/pandora/.config/recognition/edge-sync-agent.env no box (chmod 600 —
# vai ganhar a chave/identidade do device) e ajustar. NUNCA commitar o .env real.

# ── Identidade (PR-A) ─────────────────────────────────────────────────────────
# Obrigatório: id do device (usado no enroll; deve ser único por tenant).
DEVICE_ID=rvb-blumenau-01-orin
# Nome amigável pro enroll (padrão: igual a DEVICE_ID se omitido).
DEVICE_NAME=RVB Blumenau — Orin NX 01

# Token one-time do admin — só necessário no 1º boot (enroll é idempotente:
# pulado se já existe identidade persistida em EDGE_DEVICE_KEY_PATH). Gerar em
# POST /api/v1/edge/sites/<site_id>/enrollment-tokens. Apagar daqui depois do
# 1º enroll bem-sucedido (já foi consumido, é one-time).
ENROLLMENT_TOKEN=

# Path da chave privada RS256 do device (chmod 600 — o token_manager cuida
# disso sozinho). Sem sudo no box: usar um path dentro do $HOME de pandora,
# NÃO o default do código (/var/lib/recognition-edge/..., root-only).
EDGE_DEVICE_KEY_PATH=/home/pandora/.config/recognition/keys/device_key.pem

# ── Cloud ────────────────────────────────────────────────────────────────────
# Default do código já é DEV se omitido — deixar explícito aqui evita
# ambiguidade. NUNCA apontar pra produção num device de teste.
EDGE_API_URL=https://api-v3-desenvolvimento.up.railway.app

# ── Heartbeat (PR-B) ─────────────────────────────────────────────────────────
EDGE_HEARTBEAT_INTERVAL_S=45
EDGE_VERSION=
# Tocado a cada heartbeat 201 — o updater da OTA (unit separada, ver
# edge-sync-agent-updater.service) lê o mtime como prova de vida pós-restart.
# Default (deixar comentado) já bate com OTA_HEARTBEAT_SENTINEL abaixo — só
# defina os dois se quiser mudar o path, e sempre os dois juntos.
# EDGE_HEARTBEAT_SENTINEL_PATH=/home/pandora/.local/state/recognition/heartbeat.ok

# ── Sync loops (PR-C: uploader/sqlite_buffer) ───────────────────────────────
SQLITE_BUFFER_PATH=/home/pandora/.local/share/recognition/edge-sync/buffer.db
UPLOAD_BATCH_SIZE=500

# ── Evidence API + descoberta ONVIF (task-090/091/096 — já em produção neste
# daemon antes do PR-C; ver services/edge-sync-agent/AGENT.md p/ detalhe) ────
EVIDENCE_API_BIND_HOST=100.93.126.76
EVIDENCE_API_PORT=8443
EVIDENCE_TRUST_PUBLIC_KEY_PATH=/home/pandora/.config/recognition/keys/evidence_trust_public_key.pem
TENANT_ID=
SITE_ID=

RECORDER_PROTOCOL=
RECORDER_HOST=
RECORDER_PORT=
RECORDER_USERNAME=
RECORDER_PASSWORD=
RECORDER_CHANNEL_MAP={}

# ── Coletor de frames — Onda 2 shadow mode (task-092/093), unit separada
# edge-frame-collector.service, lida por `python -m app.collector` ─────────
# UUID do public.recorders na nuvem (diferente de RECORDER_HOST/PORT acima,
# que são a conexão local ao gravador) — obrigatório para o coletor, não tem
# default. Gerar cadastrando o gravador via POST /api/v1/recorders na nuvem.
RECORDER_CLOUD_ID=
# Câmeras monitoradas = as chaves de RECORDER_CHANNEL_MAP acima (reaproveitado,
# sem lista separada). Ajustes abaixo têm default sensato em collector_loop.py
# — só sobrescreva se for tunar o comportamento.
# COLLECTOR_MODULE_CODE=epi
# COLLECTOR_POLL_INTERVAL_S=3.0
# COLLECTOR_MOTION_THRESHOLD=8.0
# COLLECTOR_BURST_COUNT=8
# COLLECTOR_BURST_INTERVAL_S=1.0
# COLLECTOR_COOLDOWN_S=30.0
# COLLECTOR_TARGET_FRAMES_PER_CAMERA=1000

# ONVIF_DISCOVERY_TIMEOUT_S=3.0
# ONVIF_DISCOVERY_MAX_RESPONSES=50
# ONVIF_DISCOVERY_ENRICH_DEVICE_INFO=true

# ── OTA bare-metal (ADR-0057 item 10) — lido por `python -m app.ota`, a unit
# separada edge-sync-agent-updater.service/.timer, NÃO pelo daemon principal.
# "Versão" = git ref, sem Docker (docs/edge/REGRAS_PLATAFORMA_JETSON.md §3.4).
# ────────────────────────────────────────────────────────────────────────────
# Repo git usado como fonte pra `git worktree add` (git fetch roda aqui).
# Obrigatório — sem default sensato (path do checkout no box).
OTA_SOURCE_REPO=/home/pandora/recognition-src
# Os 4 abaixo têm default sensato em app/ota/__main__.py — só sobrescreva se
# for mudar o layout combinado com o ExecStart/WorkingDirectory da unit
# principal (edge-sync-agent.service usa %h/recognition/current fixo).
# OTA_RELEASES_ROOT=/home/pandora/recognition/releases
# OTA_CURRENT_SYMLINK=/home/pandora/recognition/current
# OTA_UNIT_NAME=edge-sync-agent
# OTA_HEARTBEAT_SENTINEL=/home/pandora/.local/state/recognition/heartbeat.ok
OTA_CHANNEL=dev
OTA_KEEP_LAST=3

LOG_LEVEL=INFO
