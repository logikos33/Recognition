# Config do coletor de telemetria (task-100). Copiar para
# /etc/recognition/edge-telemetry.env no box e ajustar.

# Obrigatório: id do device (bate com o enrollment; ver task-097).
EDGE_DEVICE_ID=rvb-blumenau-01-orin

# Fase da captura: 'idle' (baseline ocioso) ou 'inference' (sob carga).
# Trocar e reiniciar o serviço ao subir o pipeline DeepStream (task-088).
EDGE_TELEMETRY_PHASE=idle

# Onde os datasets JSONL são gravados (um arquivo por execução).
EDGE_TELEMETRY_DIR=/home/pandora/edge-telemetry

# Intervalo de amostragem do tegrastats, em ms.
TEGRASTATS_INTERVAL_MS=5000

# Versão do stack edge (aparece no heartbeat).
EDGE_VERSION=

# --- Sink de heartbeat (OPCIONAL) --------------------------------------------
# Deixe em branco para captura só-local (baseline). Preencha os DOIS para
# empurrar telemetria à API de observabilidade (requer device enrolado — RS256).
# EDGE_API_URL=https://api-v3-production-2b22.up.railway.app
# EDGE_DEVICE_BEARER=
