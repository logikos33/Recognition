# edge.env.example — variáveis da stack co-residente (task-113).
# Copiar para /etc/recognition/edge.env, ajustar, `chmod 600` (contém segredos).
# NUNCA commitar o edge.env real (só este .example). Ver REGRAS §3 (segredos).

# ── Banco / cache locais no edge ──
DATABASE_URL=postgresql://recognition:CHANGEME@127.0.0.1:5432/recognition
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ──
JWT_SECRET_KEY=CHANGEME_LONGO_ALEATORIO

# ── Modo de deploy (edge = produção no site) ──
DEPLOYMENT_MODE=edge

# ── Cloud (para o edge-sync-agent relay e heartbeat) ──
CLOUD_API_BASE=https://api-v3-production-2b22.up.railway.app
# Device token RS256 (do enrollment — ver runbook FASE 3). chmod 600!
EDGE_DEVICE_TOKEN=

# ── Relay de detecções (ADR-0002) ──
DETECTIONS_CHANNEL_TEMPLATE=detections:{camera_id}
