# ============================================================
# EPI Monitor V2 — Environment Variables
# Railway injeta DATABASE_URL e REDIS_URL automaticamente.
# ============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=gere-com-python-c-import-secrets-secrets.token_hex-32
SERVICE_TYPE=api

# --- JWT ---
JWT_SECRET_KEY=gere-com-python-c-import-secrets-secrets.token_hex-32
JWT_EXPIRY_HOURS=24

# --- Database (Railway PostgreSQL plugin) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/epi_monitor

# --- Redis (Railway Redis plugin) ---
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (object storage) ---
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=epi-monitor
R2_KEY=your_access_key_id
R2_SECRET=your_secret_access_key

# --- CORS (produção: URL do frontend Railway) ---
CORS_ORIGINS=http://localhost:3000

# --- Camera encryption (Fernet key) ---
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_SECRET_KEY=

# --- Ultralytics Hub (treinamento em nuvem) — LEGADO, remoção na task-086 ---
# Dispatch de treino via Hub produz modelos derivados de pesos AGPL; o
# pipeline de treino LGPD-clean/Apache (RF-DETR/YOLOX) da task-086 substitui.
# Deixar vazio (o dispatch cai em Vast.ai ou simulação).
ULTRALYTICS_HUB_API_KEY=
ULTRALYTICS_HUB_PROJECT_ID=

# --- Worker ---
WORKER_ID=worker-1
# Detector servido = ONNX Apache 2.0 (ADR-0043/0044) — nunca pesos ultralytics (.pt)
DETECTOR_BACKEND=yolox_onnx
DETECTOR_MODEL_PATH=models/yolox_s.onnx
DETECTION_CONFIDENCE=0.5

# --- Email (recuperação de senha — ADR-0042 Fase 2) ---
# EMAIL_PROVIDER=resend (default) ou smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=sua_chave_resend
EMAIL_FROM=Recognition <naoresponda@seu-dominio.com>
# Fallback SMTP genérico (usado se EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# URL pública do frontend — usada para montar o link de reset-password
FRONTEND_URL=http://localhost:3000

# --- Admin (criado automaticamente no primeiro deploy) ---
ADMIN_EMAIL=admin@epimonitor.com
ADMIN_PASSWORD=EpiMonitor@2024!
ADMIN_NAME=Administrador

# --- Frontend (Vite env vars — prefixo VITE_) ---
VITE_API_URL=http://localhost:5001
VITE_WS_URL=ws://localhost:5001
